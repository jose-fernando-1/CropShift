{
  "$id": "https://fieldshift.local/contract/0.1/recommendation-request.schema.json",
  "title": "Field Shift recommendation-request (contract v0.1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "soil_class": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            }
          ],
          "description": "ZARC soil class: 1 sandy, 2 medium, 3 clayey"
        },
        "regime": {
          "type": "string",
          "enum": [
            "rainfed",
            "irrigated"
          ]
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "municipality_code": {
          "type": "string",
          "pattern": "^\\d{7}$",
          "description": "7-digit IBGE municipality code"
        },
        "soil_class": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            }
          ],
          "description": "ZARC soil class: 1 sandy, 2 medium, 3 clayey"
        },
        "regime": {
          "type": "string",
          "enum": [
            "rainfed",
            "irrigated"
          ]
        }
      },
      "required": [
        "municipality_code"
      ],
      "additionalProperties": false
    }
  ]
}
