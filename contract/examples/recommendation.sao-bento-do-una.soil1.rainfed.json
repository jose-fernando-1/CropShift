  "disclaimers": [
    {
      "id": "mock",
      "text": "Demo data: success probabilities are synthetic. ZARC windows and PAM yields are real public data."
    },
    {
      "id": "scale",
      "text": "Climate comes from NASA POWER cells of 0.5° × 0.625° (about 55 × 69 km). It does not describe your field."
    },
    {
      "id": "soil",
      "text": "Soil water is an assumption (0.11 m³/m³ available water, sandy loam), not a measurement."
    },
    {
      "id": "rain",
      "text": "Rainfall is POWER's; in 2024 IMERG measured about 37% less at the test point. Results depend on the rain source."
    },
    {
      "id": "validation",
      "text": "Independent validation against PAM yields is weak to moderate (rank correlation +0.33 to +0.48, one point)."
    },
    {
      "id": "zarc",
      "text": "ZARC is also built from a water balance, so agreeing with it shows consistency with the official method, not field success."
    },
    {
      "id": "dekad",
      "text": "Dekad 1 is assumed to be Jan 1–10, and ZARC values 20/30/40 are shown as-is; their meaning as risk % is not confirmed."
    }
  ]
