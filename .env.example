# Optional overrides for `docker compose` (copy to .env; it is git-ignored). Every value has a default.
# The backend's own settings for running outside containers live in backend/.env (see backend/.env.example).

# WEB_PORT=3000
# LANDING_PORT=3002
# API_PORT=8000
# DB_PORT=5433

# POSTGRES_USER=rurotation
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=rurotation

# `make stack` sets these; set them yourself when running compose by hand.
# API_MODE=live
# API_ORIGIN=http://api:8000

# Optional: enables AI-written explanations (otherwise the template is used). Never commit a real key.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Behind the web proxy every client shares its IP unless the proxy container is trusted (container IP or subnet, not a service name).
# RATE_LIMIT_PER_MIN=60
# TRUSTED_PROXIES=
