# Backend settings for running OUTSIDE containers (copy to backend/.env; git-ignored).
# Every value has a default, so this file is optional. Inside compose/devcontainer the
# environment already sets the database host (db) and port (5432).

APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Database: either the parts below (a password with special characters is percent-encoded for you)...
POSTGRES_USER=rurotation
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rurotation
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# ...or one full URL, which wins when set:
# DATABASE_URL=postgresql+psycopg://rurotation:change_me@localhost:5433/rurotation

# The web app calls the API through its same-origin proxy, so no CORS origin is needed.
# Set it only to call the API straight from a browser, e.g. CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=

# Optional AI explanations. Empty = deterministic template. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=
