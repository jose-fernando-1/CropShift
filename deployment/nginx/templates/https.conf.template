# HTTPS server for ${DOMAIN}. Rendered by entrypoint.sh once /etc/letsencrypt/live/${DOMAIN}/ exists.
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;

# Plain HTTP: ACME challenges, the container health probe, and a redirect to the configured domain.
server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
    # Redirect to the configured domain, not to $host: a forged Host header cannot steer the redirect.
    location / { return 301 https://${DOMAIN}${HTTPS_PORT_SUFFIX}$request_uri; }
}

# Any other hostname or a bare IP over TLS: refuse the handshake (no certificate is shown).
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;
    client_max_body_size 64k;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    resolver 127.0.0.11 valid=10s ipv6=off;
    include /etc/nginx/cropshift-common.inc;

    proxy_hide_header X-Powered-By;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;

    # The web app lives under /demo (Next.js basePath), so nginx forwards the path unchanged (no URI on proxy_pass).
    # Its API is only reachable through the app's same-origin proxy; nginx adds a coarse per-IP limit on top of the
    # api's own limiter.
    location /demo/api/ {
        limit_req zone=api burst=60 nodelay;
        limit_req_status 429;
        set $upstream http://web:3000;
        proxy_pass $upstream;
    }

    location = /demo {
        set $upstream http://web:3000;
        proxy_pass $upstream;
    }

    location /demo/ {
        set $upstream http://web:3000;
        proxy_pass $upstream;
    }

    # The app used to live at /: its shared links always carry `mun` (the selected municipality). Only those move to
    # /demo, so other query strings (utm_source, fbclid, ...) still show the landing page.
    location = / {
        # Relative Location header, so the redirect keeps the host and any non-standard port the browser used.
        absolute_redirect off;
        if ($arg_mun) { return 302 /demo?$args; }
        set $upstream http://landing:3000;
        proxy_pass $upstream;
    }

    # Everything else is the landing page.
    location / {
        set $upstream http://landing:3000;
        proxy_pass $upstream;
    }
}
