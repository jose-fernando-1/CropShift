# Production settings, normally written by `sudo ./deployment/install.sh` (it asks for each value).
# Copy to deployment/.env only if you configure by hand. The real .env holds secrets: mode 600, never committed.

# --- Required ---
DOMAIN=cropshift.example.org
LETSENCRYPT_EMAIL=you@example.org
POSTGRES_PASSWORD=change-me-long-random

# --- Certificates: letsencrypt | letsencrypt-staging (testing, untrusted certs) | selfsigned (no public DNS) ---
CERT_MODE=letsencrypt

# --- Optional ---
# AI-written explanations (the template is used when empty). Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
# Hide the "Data flow" inspector on a public demo.
SHOW_DATA_FLOW=false
RATE_LIMIT_PER_MIN=60
LOG_LEVEL=INFO

# --- Advanced (defaults are fine) ---
# POSTGRES_USER=rurotation
# POSTGRES_DB=rurotation
# HTTP_PORT=80
# HTTPS_PORT=443
# HTTPS_PORT_SUFFIX=:8443   # only when HTTPS_PORT is not 443 (used in the http->https redirect)
