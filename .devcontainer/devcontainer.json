{
  "name": "Cropshift (web)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "node",
  "mounts": [
    "source=cropshift-web-node-modules-${devcontainerId},target=/workspaces/${localWorkspaceFolderBasename}/web/node_modules,type=volume"
  ],
  "containerEnv": {
    "API_MODE": "mock",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [3000, 3001],
  "portsAttributes": {
    "3000": { "label": "web (next dev)", "onAutoForward": "notify" },
    "3001": { "label": "web, second instance (live-mode test)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
