# Editor defaults for every file in the repo. Prettier reads these too; .prettierrc.json wins where both set a value.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

[*.md]
trim_trailing_whitespace = false

[Dockerfile]
indent_size = 4

[Makefile]
indent_style = tab
