# Where /api/* is served from. Read at request time: no rebuild needed to switch.
#   mock (default): in-process mock API with fixture data (mock: true everywhere)
#   live:           proxy to the FastAPI backend at API_ORIGIN
API_MODE=mock

# FastAPI origin for API_MODE=live (no trailing slash). Example for docker compose: http://api:8000
API_ORIGIN=

# Upstream timeout for live mode, in milliseconds.
API_TIMEOUT_MS=15000

# Mock only: fixed latency in ms (unset = random 300-900 ms, 0 = none).
# MOCK_LATENCY_MS=0

# `npm start` only: interface the standalone server binds to (default 0.0.0.0).
# WEB_HOST=0.0.0.0
